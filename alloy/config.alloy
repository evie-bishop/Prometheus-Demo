prometheus.scrape "demo_app" {
  targets = [
    {
      __address__ = sys.env("APP_TARGET"),
      job         = sys.env("SCRAPE_JOB_NAME"),
    },
  ]
  forward_to = [prometheus.remote_write.elastic.receiver]
}
prometheus.remote_write "elastic" {
  endpoint {
    url = sys.env("ES_ENDPOINT") + "/_prometheus/api/v1/write"
    headers = {
      Authorization = "ApiKey " + sys.env("ES_API_KEY"),
    }
  }
}
