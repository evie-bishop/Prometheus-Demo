# Prometheus-Demo configuration
#
# Copy to .env and fill in the secret values. Defaults are pinned in this file
# and changes to them must be made via PR.
# Python package versions are pinned in app/requirements.txt.

# ---- Active compose profiles (run both ingestion paths by default) ----
# Override with `--profile prometheus` or `--profile alloy` to run just one.
COMPOSE_PROFILES=prometheus,alloy

# ---- Image versions (change via PR) ----
PYTHON_IMAGE=python:3.14-slim
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
ALLOY_IMAGE=grafana/alloy:v1.16.0

# ---- Container names ----
APP_CONTAINER_NAME=demo-metrics-app
PROMETHEUS_CONTAINER_NAME=demo-prometheus
ALLOY_CONTAINER_NAME=demo-alloy

# ---- Host port mappings ----
APP_PORT=8000
PROMETHEUS_PORT=9090
ALLOY_PORT=12345

# ---- App / scrape target ----
APP_INTERNAL_PORT=8000
SCRAPE_JOB_NAME=demo-python-app

# ---- Prometheus runtime ----
PROMETHEUS_SCRAPE_INTERVAL=5s

# ---- Elasticsearch remote_write target (set locally; do not commit secrets) ----
#
# Generate ES_API_KEY in Kibana Dev Tools (Management > Dev Tools > Console).
# Scoped to the minimum privileges needed for Prometheus remote_write into
# the metrics-* data stream:
#
#   POST /_security/api_key
#   {
#     "name": "prometheus-demo-write",
#     "role_descriptors": {
#       "prometheus_demo_writer": {
#         "cluster": ["monitor"],
#         "indices": [
#           {
#             "names": ["metrics-*"],
#             "privileges": ["auto_configure", "create_doc", "create_index", "write"]
#           }
#         ]
#       }
#     }
#   }
#
# Use the "encoded" field from the response as ES_API_KEY (it is the
# base64 of "<id>:<api_key>" that Prometheus/Alloy expect for ApiKey auth).
ES_ENDPOINT=https://YOUR_ES_ENDPOINT
ES_API_KEY=YOUR_API_KEY
